# Server tự nạp file này khi khởi động (python-dotenv).

# ----- LLM (LM Studio) -----
LM_URL=http://localhost:1234/v1
LM_MODEL=qwen2.5-7b-instruct
LM_TEMPERATURE=0.35
# LM_SEED=42                 # bật khi so sánh prompt bằng replay.py
MAX_REPLY_TOKENS=160
MAX_HISTORY=3                # số cặp hỏi/đáp trước đó gửi cho LLM
INTERVIEW_FOLLOWUPS=1        # câu hỏi phụ tối đa cho mỗi câu hỏi chính

# ----- STT (faster-whisper) -----
# GPU (sau khi cài DLL CUDA, xem README):
#   STT_MODEL=distil-large-v3 hoặc large-v3-turbo, STT_DEVICE=cuda, STT_COMPUTE=float16
# Nếu GPU lỗi, server tự chuyển về CPU int8 và ghi rõ ở cột trái.
STT_MODEL=large-v3-turbo
STT_DEVICE=cuda
STT_COMPUTE=float16
STT_THREADS=8
STT_BEAM=3
# Từ vựng riêng giúp Whisper nghe đúng tên và từ nghề. Sửa cho đúng với bạn.
STT_VOCAB=Hi, I'm <tên của bạn>.
# Dưới ngưỡng này thì không gửi cho AI mà nhờ bạn nói lại. Xem số ở cột trái để chỉnh.
STT_MIN_LOGPROB=-1.0
STT_MAX_NO_SPEECH=0.6
# Giữ file ghi âm để chạy stt_bench.py. Để trống thì xóa sau khi nhận dạng.
SAVE_AUDIO_DIR=recordings

# ----- TTS -----
TTS_VOICE=en-US-JennyNeural
TTS_RATE=-10%
