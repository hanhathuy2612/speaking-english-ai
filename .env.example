# Server tự nạp file này khi khởi động (python-dotenv).

# ----- LLM (LM Studio) -----
LM_URL=http://localhost:1234/v1
LM_MODEL=qwen2.5-7b-instruct
LM_TEMPERATURE=0.35
# LM_SEED=42                 # bật khi so sánh prompt bằng replay.py
MAX_REPLY_TOKENS=256
MAX_HISTORY=3                # số cặp hỏi/đáp trước đó gửi cho LLM
INTERVIEW_FOLLOWUPS=1        # câu hỏi phụ tối đa cho mỗi câu hỏi chính

# ----- STT (faster-whisper) -----
# GPU (sau khi cài DLL CUDA, xem README):
#   STT_MODEL=distil-large-v3 hoặc large-v3-turbo, STT_DEVICE=cuda, STT_COMPUTE=float16
# Nếu GPU lỗi, server tự chuyển về CPU int8 và ghi rõ ở cột trái.
STT_MODEL=large-v3-turbo
STT_DEVICE=cuda
STT_COMPUTE=float16
STT_THREADS=8
STT_BEAM=3
# Từ vựng riêng giúp Whisper nghe đúng tên và từ nghề. Sửa cho đúng với bạn.
STT_VOCAB=Hi, I'm <tên của bạn>.
# Dưới ngưỡng này thì không gửi cho AI mà nhờ bạn nói lại (số đo: docs/features/speech-recognition.md).
STT_MIN_LOGPROB=-1.0
STT_MAX_NO_SPEECH=0.6
# 1 = để Whisper tự nhận ngôn ngữ, bắt được cả câu tiếng Việt bị máy dịch sang tiếng Anh. Chậm thêm ~0,24 giây/lượt.
# 0 = chỉ bắt câu nhận dạng ra chữ tiếng Việt có dấu (không tốn thêm thời gian).
STT_CHECK_LANGUAGE=0
# Giữ file ghi âm để chạy stt_bench.py. Để trống thì xóa sau khi nhận dạng.
SAVE_AUDIO_DIR=recordings

# ----- Lịch sử luyện tập và tài khoản -----
# MySQL 8 lưu tài khoản, các buổi tập và bài học. Bắt buộc: tài khoản lưu ở đây, thiếu thì server không chạy.
# Dạng mysql://user:mật_khẩu@host:3306/tên_database (ký tự đặc biệt trong mật khẩu phải mã hóa %xx).
# Tạo database trước: CREATE DATABASE speaking CHARACTER SET utf8mb4 COLLATE utf8mb4_bin;
# Server tự áp dụng các migration trong backend/app/migrations/ lúc khởi động (xem: python -m scripts.migrate status). Có file history.db cũ thì chép sang: python -m scripts.migrate_sqlite data/history.db
DATABASE_URL=mysql://speaking:mật_khẩu@localhost:3306/speaking
# Chỉ để chạy pytest: database RIÊNG (tên khác DATABASE_URL), test xóa và tạo lại nó mỗi lần chạy.
# TEST_DATABASE_URL=mysql://speaking:mật_khẩu@localhost:3306/speaking_test

# ----- Đăng ký và email (docs/features/accounts.md) -----
# 0 = tắt trang đăng ký, chỉ quản trị viên tạo tài khoản.
SIGNUP_ENABLED=1
# Admin mặc định: server tạo tài khoản này lúc khởi động, chỉ khi database chưa có người dùng nào
# (database mới). Đã có người dùng thì bỏ qua. Mật khẩu ít nhất 8 ký tự; đổi mật khẩu sau khi đăng nhập.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Khóa ký token đăng nhập (JWT). Để trống: server tự tạo khóa ngẫu nhiên, lưu ở data/jwt_secret.
# Đổi khóa thì mọi người phải đăng nhập lại.
JWT_SECRET=
# Địa chỉ mở app, dùng cho link trong email. Bắt buộc khi có SMTP_HOST.
APP_URL=
# Để trống SMTP_HOST thì email (link xác nhận, đặt lại mật khẩu) chỉ in ra terminal của server.
# Gmail: smtp.gmail.com, 587, starttls, SMTP_PASSWORD là App Password (không phải mật khẩu Gmail).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ----- TTS -----
TTS_VOICE=en-US-JennyNeural
TTS_RATE=-10%
# Giọng giáo viên ở phần bài giảng (khác giọng người phỏng vấn)
TTS_TEACHER_VOICE=en-US-AvaNeural

# ----- Server (python -m app, hoặc run.cmd ở thư mục gốc) -----
# 0.0.0.0 để điện thoại / máy khác cùng mạng LAN vào được; 127.0.0.1 chỉ máy này.
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
# HTTPS (cần để dùng micro từ thiết bị khác). Tạo bằng: python -m scripts.make_cert <IP LAN>
# Để trống thì chạy HTTP. Xem docs/dev-environment.md.
SSL_CERTFILE=
SSL_KEYFILE=
